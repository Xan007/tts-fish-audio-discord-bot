{
  "name": "TTS Discord Bot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.terminal.activateEnvironment": false
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
