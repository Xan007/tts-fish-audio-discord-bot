{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Discord TTS bot",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "-m",
        "src.main"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    }
  ]
}
