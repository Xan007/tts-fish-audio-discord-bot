{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Discord TTS bot",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "bash .devcontainer/setup.sh && exec .venv/bin/python -u -m src.main"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": []
    }
  ]
}
